# Build cache-fix GUI (Tauri 2) with WebKitGTK on Ubuntu
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    pkg-config \
    file \
    patchelf \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libglib2.0-dev \
    libjavascriptcoregtk-4.1-dev \
    libsoup-3.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Rust stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && rustc --version && cargo --version

# Tauri CLI 2
RUN cargo install tauri-cli --version "^2" --locked

WORKDIR /app
COPY . /app

# Compile release binary + deb bundle (Linux)
WORKDIR /app/src-tauri
RUN bash -lc 'cargo tauri build --bundles deb 2>&1 | tee /tmp/tauri-build.log; exit ${PIPESTATUS[0]}' \
    && test -x /app/src-tauri/target/release/cache-fix-gui
# Keep artifacts easy to find
RUN mkdir -p /out \
    && find /app/src-tauri/target/release -maxdepth 3 -type f \( -name 'cache-fix-gui' -o -name '*.deb' \) -print \
    && find /app/src-tauri/target -name 'cache-fix-gui' -type f -executable -exec cp -v {} /out/ \; \
    && find /app/src-tauri/target -name '*.deb' -type f -exec cp -v {} /out/ \; \
    && ls -la /out \
    && test "$(ls -A /out)"