{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cache-fix GUI",
  "version": "0.1.0",
  "identifier": "com.bingzi.cache-fix-gui",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:19801",
    "beforeDevCommand": "npm run panel:no-open",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cache-fix GUI — claude-code-cache-fix",
        "width": 860,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:19801 http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "resources": [
      "../bin",
      "../src",
      "../ui",
      "../package.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
